# Required: PostgreSQL database with the PostGIS extension enabled.
DB_URL=
# Generate a fresh, random secret of at least 32 characters. Never reuse a leaked key.
JWT_SECRET_KEY=

CACHE_TYPE=RedisCache
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_PASSWORD=
CACHE_REDIS_URL=
CACHE_DEFAULT_TIMEOUT=300

# Cloudinary image uploads
CLOUD_NAME=
API_KEY=
API_SECRET=

# Twilio verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VERIFY_SERVICE_SID=
TWILIO_NUMBER=

# Optional email integration
SENDGRID_API_KEY=
MAIL_DEFAULT_SENDER=
